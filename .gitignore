# Build outputs
/bin/
/services/processor/target/

# Local secrets and environment files (see SPECIFICATIONS.md section 31)
.env
.env.*
!.env.example

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Rendered Kubernetes manifests, rebuilt by `make k8s-validate` on every run.
/infrastructure/kubernetes/.rendered/

# Terraform. State can hold sensitive values and lives in the remote
# backend; provider plugins are downloaded per machine. The dependency lock
# files (.terraform.lock.hcl) are deliberately NOT ignored: they pin provider
# checksums and belong in review like any other lock file.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Per-deployment values (account ids, admin ARNs, allowed CIDRs). Not
# secrets, but specific to one AWS account; the .example beside each is
# what is committed.
terraform.tfvars

# Load test reports and raw k6 summaries (make load-test).
/tests/load/results/

# Synthetic fixtures written by make synth-generate (regenerate them from a seed).
/.synth/

# Go coverage profiles, written by make test-go, the integration targets and
# make e2e-test, merged by make coverage-go.
services/api-gateway/coverage*.out
services/api-gateway/coverage.txt

# Go test binaries left behind by -cpuprofile/-memprofile runs.
*.test

# Software bills of materials, written by make sbom. An SBOM describes one
# build of one image, so it is an artifact of a run: CI uploads it and the
# release attaches it, rather than it living in the tree.
/sbom/
