{
  "uid": "vitalmesh-latency-errors",
  "title": "VitalMesh \u00b7 Latency and errors",
  "description": "How long requests take and how often they fail. Percentiles and the error ratio come from the same recorded rules the alerts fire on, so a dashboard and an alert cannot disagree.",
  "tags": [
    "vitalmesh",
    "api",
    "slo"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Server error ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "vitalmesh-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vitalmesh-prometheus"
          },
          "expr": "job:gateway_http_server_error_ratio:rate5m",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Failures that are the service's own fault. Alerts at 5%."
    },
    {
      "type": "stat",
      "title": "p99 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "vitalmesh-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vitalmesh-prometheus"
          },
          "expr": "job:gateway_http_latency:p99",
          "legendFormat": "p99",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "What the slowest one request in a hundred experiences."
    },
    {
      "type": "timeseries",
      "title": "Latency percentiles",
      "datasource": {
        "type": "prometheus",
        "uid": "vitalmesh-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vitalmesh-prometheus"
          },
          "expr": "job:gateway_http_latency:p50",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vitalmesh-prometheus"
          },
          "expr": "job:gateway_http_latency:p95",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vitalmesh-prometheus"
          },
          "expr": "job:gateway_http_latency:p99",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "A p99 that rises while the p50 does not is a tail problem, not a slowdown."
    },
    {
      "type": "timeseries",
      "title": "Errors per second by class",
      "datasource": {
        "type": "prometheus",
        "uid": "vitalmesh-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vitalmesh-prometheus"
          },
          "expr": "job:gateway_http_errors:rate5m",
          "legendFormat": "{{class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Client errors are callers sending bad requests; server errors are ours."
    },
    {
      "type": "timeseries",
      "title": "p99 latency by route",
      "datasource": {
        "type": "prometheus",
        "uid": "vitalmesh-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vitalmesh-prometheus"
          },
          "expr": "route:gateway_http_latency:p99",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Dependency latency (p99)",
      "datasource": {
        "type": "prometheus",
        "uid": "vitalmesh-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vitalmesh-prometheus"
          },
          "expr": "job:gateway_database_latency:p99",
          "legendFormat": "PostgreSQL",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vitalmesh-prometheus"
          },
          "expr": "job:gateway_redis_latency:p99",
          "legendFormat": "Redis",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Compare with request latency: a rise here explains a rise there."
    },
    {
      "type": "table",
      "title": "Routes by error ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "vitalmesh-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vitalmesh-prometheus"
          },
          "expr": "topk(10, route:gateway_http_server_error_ratio:rate5m)",
          "legendFormat": "{{route}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "description": "Where the failures are concentrated.",
      "transformations": [
        {
          "id": "organize",
          "options": {}
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
