{
  "uid": "vitalmesh-api-traffic",
  "title": "VitalMesh \u00b7 API traffic",
  "description": "What the gateway is being asked to do: request rates by route, method and status. Routes are patterns, never paths, so no series here grows with the data.",
  "tags": [
    "vitalmesh",
    "api"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Requests per second",
      "datasource": {
        "type": "prometheus",
        "uid": "vitalmesh-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vitalmesh-prometheus"
          },
          "expr": "job:gateway_http_requests:rate5m",
          "legendFormat": "requests/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Every request the gateway served, from the recorded rule the alerts also use."
    },
    {
      "type": "stat",
      "title": "In-flight processing jobs",
      "datasource": {
        "type": "prometheus",
        "uid": "vitalmesh-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vitalmesh-prometheus"
          },
          "expr": "vitalmesh_operation_in_flight{operation=\"processing.job\"}",
          "legendFormat": "active",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Jobs whose work is running right now, as the gateway sees them."
    },
    {
      "type": "timeseries",
      "title": "Requests per second by route",
      "datasource": {
        "type": "prometheus",
        "uid": "vitalmesh-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vitalmesh-prometheus"
          },
          "expr": "route:gateway_http_requests:rate5m",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Requests per second by status",
      "datasource": {
        "type": "prometheus",
        "uid": "vitalmesh-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vitalmesh-prometheus"
          },
          "expr": "sum by (status) (rate(vitalmesh_http_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "A shift from 2xx to 4xx is usually a client change; to 5xx is usually ours."
    },
    {
      "type": "timeseries",
      "title": "Rate-limit decisions",
      "datasource": {
        "type": "prometheus",
        "uid": "vitalmesh-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vitalmesh-prometheus"
          },
          "expr": "sum by (decision, backend) (rate(vitalmesh_rate_limit_decisions_total[5m]))",
          "legendFormat": "{{decision}} ({{backend}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "A local backend means Redis is unavailable and each replica is limiting on its own."
    },
    {
      "type": "table",
      "title": "Busiest routes",
      "datasource": {
        "type": "prometheus",
        "uid": "vitalmesh-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vitalmesh-prometheus"
          },
          "expr": "topk(10, route:gateway_http_requests:rate5m)",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "description": "The ten routes taking the most traffic right now.",
      "transformations": [
        {
          "id": "organize",
          "options": {}
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
