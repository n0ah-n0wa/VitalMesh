# Copy to .env to override any of the defaults in docker-compose.yml:
#
#   cp .env.example .env
#
# Nothing here is required. Every variable has a development default, so
# `docker compose up` works on a clean checkout with no .env at all. This
# file exists to document what can be changed and to be the place a real
# value goes locally, because .env is git-ignored and this file is not
# (SPECIFICATIONS.md section 31).
#
# None of the defaults is a secret. They are development values, chosen to
# be obviously local and useless anywhere else. A deployment supplies real
# values through its own secret store and never through a file like this.

# --- ports published on the host ------------------------------------
# Change one if something else on your machine already has the port.
GATEWAY_PORT=8080
PROCESSOR_PORT=8081
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- database --------------------------------------------------------
POSTGRES_USER=vitalmesh
POSTGRES_PASSWORD=vitalmesh
POSTGRES_DB=vitalmesh

# --- credentials -----------------------------------------------------
# Signs access tokens. At least 32 characters; start-up refuses a shorter
# one. Generate a local value with:  openssl rand -base64 48
JWT_SECRET=local-development-signing-key-not-a-secret

# Authenticates the gateway to the processor over the internal API. Both
# services read the same variable, so changing it here changes both.
PROCESSOR_TOKEN=local-development-internal-token

# --- behaviour -------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=info
LOG_FORMAT=json

# Where traces go. Point it somewhere else, or set it to an empty value, to
# stop exporting: the services still propagate trace context and log trace
# ids either way.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Stamped into both binaries and reported by /health, so a running service
# can be traced back to what built it. `make docker-build` sets it to the
# commit; `docker compose build` on its own leaves it `dev`.
VERSION=dev

# Tags the images that `docker compose build` produces. Separate from
# VERSION so an image can be tagged for the local environment while the
# binary inside it still names the commit it came from.
IMAGE_TAG=dev
